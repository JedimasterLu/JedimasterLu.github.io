---
import { readFile } from "node:fs/promises";
import { join } from "node:path";
import Publications from "../components/publications.astro";
import Portrait from "../components/portrait.astro";
import Footer from "../components/footer.astro";
import Table from "../components/table.astro";
import Figure from "../components/figure.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
import bodyGridScript from "../scripts/body-grid?raw";

const scholarUrl = `https://scholar.google.com/citations?user=${site.links.scholarId}&hl=en`;
const scholarStatsPath = join(process.cwd(), "public", "data", "scholar-stats.json");

let citations = "";
let hIndex = "";

try {
  const stats = JSON.parse(await readFile(scholarStatsPath, "utf-8"));
  citations = stats?.citations ?? "";
  hIndex = stats?.hIndex ?? "";
} catch (e) {
  console.error("Failed to read Google Scholar cache");
}

const lastUpdated = new Date().toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const sameAs = [site.links.github, site.links.linkedin, scholarUrl].filter(Boolean) as string[];

const schema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.meta.author,
  url: site.links.siteUrl,
  jobTitle: site.schema.jobTitle,
  affiliation: {
    "@type": "Organization",
    name: site.schema.affiliation,
  },
  alumniOf: {
    "@type": "Organization",
    name: site.schema.alumniOf,
  },
  email: site.links.email,
  image: `${site.links.siteUrl}${site.meta.favicon}`,
  sameAs,
  knowsAbout: site.schema.knowsAbout,
};
---

<BaseLayout meta={site.meta} schema={schema}>
  <main class="page">
    <div class="top-rule"></div>
    <div class="brand">{site.brand.header}</div>

    <div class="header-row">
      <div class="kicker">{site.header.kicker}</div>
      <a href={site.links.siteUrl}>{site.header.linkText}</a>
    </div>

    <div class="lead-group">
      <h1 class="lead-title">{site.hero.name}</h1>
      <h2 class="lead-subtitle">{site.hero.subtitle}</h2>
    </div>

    <section class="meta-grid">
      <div class="meta-list">
        {site.contact.addressLines.map((line) => (
          <span>{line}</span>
        ))}
        <span>
          Email: <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
        </span>
        <span>
          {site.contact.lastUpdatedLabel} {lastUpdated}
        </span>
      </div>
      <div class="abstract">
        {site.about.paragraphs.map((paragraph) => (
          <p set:html={paragraph}></p>
        ))}
      </div>
    </section>

    <div class="body-grid">
      <section class="body-block">
        <h2>Portrait</h2>
        <Portrait imageName="portrait.png" caption="Fig 1 | Taken at DuSable Bridge, Chicago in December 2025." />
      </section>

      <section class="body-block">
        <h2>News</h2>
        <div class="newslist">
          {site.news.map((item) => (
            <div class="news-item">
              <div class="news-date">{item.date}</div>
              <div class="news-line" aria-hidden="true"></div>
              <div class="news-text">{item.text}</div>
            </div>
          ))}
        </div>
      </section>

      <section class="body-block">
        <h2>Publications</h2>
        <Publications bibFileName={site.publications.bibFileName} authorName={site.publications.authorName} />
        <p class="no-justify">
          <a href={scholarUrl} target="_blank" rel="noopener">Google Scholar</a>
          {citations && hIndex ? ` (citations: ${citations}, h-index: ${hIndex})` : ""}
        </p>
      </section>

      <section class="body-block">
        <h2>Projects</h2>
        {site.projects.map((project) => (
          <div class="project-block">
            <h3>{project.title}</h3>
            {project.figure ? (
              <Figure imageName={project.figure.imageName} caption={project.figure.caption} />
            ) : null}
            {project.paragraphs.map((paragraph) => (
              <p set:html={paragraph}></p>
            ))}
          </div>
        ))}
      </section>

      <section class="body-block">
        <h2>Education</h2>
        {site.education.map((entry) => (
          <div class="education-block">
            <div class="quater-tag">
              <div class="quater-row">
                <h4>{entry.degree}</h4>
                <span class="quater-time">{entry.time}</span>
              </div>
              <div class="quater-row">
                <span class="quater-major">{entry.major}</span>
                <span class="quater-school">{entry.school}</span>
              </div>
            </div>
            {entry.bullets.length ? (
              <ul>
                {entry.bullets.map((bullet) => (
                  <li>{bullet}</li>
                ))}
              </ul>
            ) : null}
          </div>
        ))}
      </section>

      <section class="body-block">
        <h2>Skills</h2>
        <Table caption={site.skills.caption} rows={site.skills.rows} />
      </section>

      <section class="body-block">
        <h2>Interests</h2>
        <p>{site.interests.intro}</p>
        <ul>
          {site.interests.items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </section>

      <section class="body-block additional-info">
        <h2>Additional Information</h2>
        {site.additionalInfo.map((item) => (
          <div class="additional-info-item">
            <h3>{item.title}</h3>
            <p set:html={item.body}></p>
          </div>
        ))}
        <p class="copyright">Copyright © {new Date().getFullYear()} {site.meta.author}.</p>
      </section>
    </div>
    <Footer
      brand={site.footer.brand}
      github={site.footer.github}
      linkedin={site.footer.linkedin}
      year={new Date().getFullYear()}
    />
  </main>

  <script type="module" is:inline set:html={bodyGridScript}></script>
</BaseLayout>
