---
import SelectedPublications from "../components/SelectedPublications.astro";

const scholarId = "g34jrUsAAAAJ";
const scholarUrl = `https://scholar.google.com/citations?user=${scholarId}&hl=en`;

let citations = "";
let hIndex = "";

try {
    const res = await fetch(scholarUrl);
    if (res.ok) {
        const html = await res.text();
        const matches = html.match(/<td class="gsc_rsb_std">(\d+)<\/td>/g);
        if (matches && matches.length >= 3) {
            citations = matches[0].replace(/<[^>]+>/g, '');
            hIndex = matches[2].replace(/<[^>]+>/g, '');
        }
    }
} catch (e) {
    console.error("Failed to fetch Google Scholar stats");
}
