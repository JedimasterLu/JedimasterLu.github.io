---
interface Props {
  caption?: string;
  rows?: { category: string; details: string }[];
}

const { caption, rows = [] } = Astro.props;
---

<table class="three-line-table">
  {caption ? <caption>{caption}</caption> : null}
  <thead>
    <tr>
      <th>Category</th>
      <th>Details</th>
    </tr>
  </thead>
  <tbody>
    {rows.map((row) => (
      <tr>
        <td>{row.category}</td>
        <td>{row.details}</td>
      </tr>
    ))}
  </tbody>
</table>

<style>
  .three-line-table {
    width: 100%;
    border-collapse: collapse;
    margin: 0.5rem 0 0.8rem;
    font-size: 1rem;
    line-height: 1.2;
    text-align: left;
  }

  .three-line-table caption {
    caption-side: top;
    padding: 0 0 0.4rem;
    font-size: 0.9rem;
    color: var(--muted);
    text-align: left;
    font-weight: 700;
  }

  .three-line-table thead {
    border-top: 1.2px solid var(--rule);
    border-bottom: 1.2px solid var(--rule);
  }

  .three-line-table thead th {
    padding: 0.5rem 0.5rem;
    text-align: left;
    font-weight: 700;
    color: var(--ink);
    vertical-align: top;
  }

  .three-line-table tbody tr {
    border-bottom: none;
  }

  .three-line-table tbody tr:last-child {
    border-bottom: 1.2px solid var(--rule);
  }

  .three-line-table td {
    padding: 0.5rem 0.5rem;
    color: var(--muted);
    text-align: left;
    vertical-align: top;
  }
</style>