---
type Props = { items: { id: string; label: string }[] };
const { items } = Astro.props as Props;
---

<aside class="side-nav" aria-label="Page navigation">
  <ul class="side-nav-list">
    {items.map((item) => (
      <li>
        <a class="side-nav-link" href={`#${item.id}`} data-target={item.id} data-label={item.label}>{item.label}</a>
      </li>
    ))}
  </ul>
  <div class="theme-switch" role="group" aria-label="Color theme">
    <button class="theme-btn" type="button" data-theme-value="light" aria-label="Light theme" title="Light" aria-pressed="false"></button>
    <span class="theme-sep" aria-hidden="true">|</span>
    <button class="theme-btn" type="button" data-theme-value="sepia" aria-label="Sepia theme" title="Sepia" aria-pressed="false"></button>
    <span class="theme-sep" aria-hidden="true">|</span>
    <button class="theme-btn" type="button" data-theme-value="dark" aria-label="Dark theme" title="Dark" aria-pressed="false"></button>
  </div>
</aside>

<script>
  function setupSideNav() {
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.side-nav-link'));
    const sections = links
      .map((l) => document.getElementById(l.dataset.target || ''))
      .filter((el): el is HTMLElement => Boolean(el));
    if (!sections.length) return;

    // After a nav click, short trailing sections (Skills/Interests/Additional) can't scroll
    // up to the reading line, so the page bottom would wrongly select the last section.
    // Keep the clicked item active until the user scrolls on their own.
    let lockedId: string | null = null;
    const unlock = () => { lockedId = null; };
    ['wheel', 'touchstart', 'keydown', 'mousedown'].forEach((ev) =>
      window.addEventListener(ev, (e) => {
        if (e.target instanceof Element && e.target.closest('.side-nav-link')) return;
        unlock();
      }, { passive: true }),
    );
    links.forEach((l) =>
      l.addEventListener('click', () => {
        lockedId = l.dataset.target || null;
        if (lockedId) setActive(lockedId);
      }),
    );

    const list = document.querySelector<HTMLElement>('.side-nav-list');
    const setActive = (id: string) => {
      links.forEach((l) => {
        const on = l.dataset.target === id;
        l.classList.toggle('is-active', on);
        if (on) l.setAttribute('aria-current', 'true');
        else l.removeAttribute('aria-current');
        // Horizontal bar on mobile: keep the active item visible.
        if (on && list && list.scrollWidth > list.clientWidth) {
          list.scrollTo({ left: l.offsetLeft - (list.clientWidth - l.offsetWidth) / 2, behavior: 'smooth' });
        }
      });
    };

    const markScrollable = () => {
      if (list) list.classList.toggle('is-scrollable', list.scrollWidth > list.clientWidth + 1);
    };
    markScrollable();
    window.addEventListener('resize', markScrollable);

    const update = () => {
      if (lockedId) return;
      const line = window.innerHeight * 0.2 + 2;
      let current = sections[0].id;
      for (const sec of sections) {
        if (sec.getBoundingClientRect().top <= line) current = sec.id;
      }
      if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4) {
        current = sections[sections.length - 1].id;
      }
      setActive(current);
    };

    // Mobile top bar: fold away while scrolling down, reveal on scroll up.
    const nav = document.querySelector<HTMLElement>('.side-nav');
    let lastY = window.scrollY;
    const fold = () => {
      if (!nav) return;
      const y = window.scrollY;
      const delta = y - lastY;
      if (y < 60 || delta < -4) nav.classList.remove('is-folded');
      else if (delta > 4) nav.classList.add('is-folded');
      if (Math.abs(delta) > 4) lastY = y;
    };

    let ticking = false;
    window.addEventListener('scroll', () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => { update(); fold(); ticking = false; });
    }, { passive: true });
    window.addEventListener('resize', update);
    // Project disclosures change page height; re-evaluate when they toggle.
    document.addEventListener('toggle', update, true);
    update();
  }

  function setupThemeSwitch() {
    const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('.theme-btn'));
    const apply = (theme: string) => {
      document.documentElement.setAttribute('data-theme', theme);
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.themeValue === theme)));
    };
    apply(document.documentElement.getAttribute('data-theme') || 'light');
    buttons.forEach((b) => {
      b.addEventListener('click', () => {
        const theme = b.dataset.themeValue || 'light';
        apply(theme);
        try { localStorage.setItem('theme', theme); } catch (e) {}
      });
    });
  }

  setupSideNav();
  setupThemeSwitch();
</script>
