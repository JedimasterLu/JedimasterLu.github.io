---
interface Props {
  imageName: string;
  caption: string;
}

const { imageName, caption } = Astro.props;
const imagePath = `src/img/${imageName}`;
---

<div class="portrait">
  <img src={imagePath} alt={caption} />
  <figcaption class="portrait-caption">{caption}</figcaption>
</div>

<style>
  .portrait {
    display: flex;
    flex-direction: column;
    align-items: left;
    margin-bottom: 1rem;
    break-inside: avoid;
  }

  .portrait img {
    max-width: min(100%, 500px);
    height: auto;
    margin-bottom: 0.8rem;
    margin-top: 1rem;
  }

  .portrait-caption {
    font-size: 0.9rem;
    color: var(--muted);
    text-align: left;
    font-weight: 700;
  }
</style>
