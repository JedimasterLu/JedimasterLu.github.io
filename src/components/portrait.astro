---
interface Props {
  imageName: string;
  caption: string;
}

const { imageName, caption } = Astro.props;
const imagePath = `src/img/${imageName}`;
---

<div class="portrait">
  <img src={imagePath} alt={caption} />
  <figcaption class="portrait-caption">{caption}</figcaption>
</div>

<style>
  .portrait {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    margin: 0 0 1rem;
  }

  .portrait img {
    width: min(100%, 360px);
    height: auto;
    margin-bottom: 0.8rem;
    margin-top: 1rem;
  }

  .portrait-caption {
    font-size: 0.9rem;
    color: var(--muted);
    width: 100%;
    text-align: justify;
    text-align-last: left;
    text-justify: inter-word;
    font-weight: 700;
  }
</style>
